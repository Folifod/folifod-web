# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/folifod?schema=public"

# Auth.js
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Email invites (Resend)
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Folifod <noreply@yourdomain.com>"

# Seed super admin (used by prisma/seed.ts)
SEED_SUPER_ADMIN_EMAIL="admin@folifod.com"
SEED_SUPER_ADMIN_PASSWORD="change-me-strong-password"
SEED_SUPER_ADMIN_NAME="Folifod Super Admin"

# Contact forms (Web3Forms)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY="your_access_key_here"

# Cloudinary (admin image uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
